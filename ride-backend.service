[Unit]
Description=Campus ride C backend
After=network.target

[Service]
Type=simple
User=ride
Group=ride
WorkingDirectory=/opt/campus-ride
Environment=RIDE_DB=/var/lib/campus-ride/ride.db
Environment=RIDE_BIND=127.0.0.1
Environment=RIDE_PORT=8080
EnvironmentFile=/etc/campus-ride.env
ExecStart=/opt/campus-ride/build/ride_server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/campus-ride
UMask=0077

[Install]
WantedBy=multi-user.target
